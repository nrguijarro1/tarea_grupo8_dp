# PostgreSQL (base administrada mediante Alembic)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Generar una clave aleatoria de al menos 32 bytes; no reutilizar valores de prueba.
JWT_SECRET_KEY=

# Necesario para subir y consultar evidencias.
SUPABASE_URL=
SUPABASE_KEY=

# Orígenes explícitos separados por comas.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_ENV=development
